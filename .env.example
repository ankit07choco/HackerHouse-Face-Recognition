# Face ID + Blockchain Verification Pipeline Configuration

# 1. Reverse Image Search API (SerpApi - Google Lens Engine)
# Get a free key at https://serpapi.com/
SERPAPI_API_KEY=your_serpapi_api_key_here

# 2. Blockchain RPC Network (Polygon Amoy Testnet default)
# Polygon Amoy RPC: https://rpc-amoy.polygon.technology/
# Ethereum Sepolia RPC: https://rpc.sepolia.org
RPC_URL=https://rpc-amoy.polygon.technology/
CHAIN_ID=80002

# 3. Recorder / Deployer Private Key (EVM Wallet with Amoy testnet MATIC)
PRIVATE_KEY=your_private_key_here

# 4. Deployed Smart Contract Address
# Leave blank to deploy or use default
CONTRACT_ADDRESS=

# 5. Block Explorer Base URL
EXPLORER_URL=https://amoy.polygonscan.com
